--  Unicode 18.0.0 properties for grapheme cluster boundaries, generated from Unicode's data
--  files by tools/generate-grapheme-tables. Do not edit by hand.

package Pyro.Grapheme_Tables with SPARK_Mode => On, Pure is

   --  The Unicode version these tables come from.
   Unicode_Version : constant String := "18.0.0";

   --  A Unicode code point.
   type Code_Point is range 0 .. 16#10FFFF#;

   --  Grapheme_Cluster_Break property values (UAX #29), Other being the default.
   type Break_Property is
     (Other,
      Carriage_Return,
      Line_Feed,
      Control,
      Extend,
      Zero_Width_Joiner,
      Regional_Indicator,
      Prepend,
      Spacing_Mark,
      Hangul_L,
      Hangul_V,
      Hangul_T,
      Hangul_LV,
      Hangul_LVT);

   --  Indic_Conjunct_Break property values, None being the default.
   type Conjunct_Property is (None, Consonant, Conjunct_Extend, Linker);

   type Break_Range is record
      First, Last : Code_Point;
      Property    : Break_Property;
   end record;

   type Conjunct_Range is record
      First, Last : Code_Point;
      Property    : Conjunct_Property;
   end record;

   type Plain_Range is record
      First, Last : Code_Point;
   end record;

   type Break_Table is array (Positive range <>) of Break_Range;
   type Conjunct_Table is array (Positive range <>) of Conjunct_Range;
   type Plain_Table is array (Positive range <>) of Plain_Range;

