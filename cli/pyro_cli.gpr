--
--  The pyro executable: ordinary Ada around the SPARK library (trusted, see docs/PROOFS.md).

with "config/pyro_cli_config.gpr";
with "pyro.gpr";

project Pyro_Cli is

   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Pyro_Cli_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("pyro_program.adb");

   package Builder is
      for Executable ("pyro_program.adb") use "pyro";
   end Builder;

   package Compiler is
      --  The library's configuration pragmas also apply when its specs are compiled here.
      for Local_Configuration_Pragmas use "../pyro.adc";
      for Default_Switches ("Ada") use
        ("-gnat2022", "-g", "-O1", "-gnatwa", "-gnatwe", "-gnatVa", "-gnatf",
         "-gnaty3", "-gnatyaAbBcdefhiIklnOprStux", "-gnatyM100");
   end Compiler;

   package Binder is
      --  The parser recurses to a fixed depth; give the main task a stack well above what that
      --  depth needs (docs/PROOFS.md, Assumptions).
      for Default_Switches ("Ada") use ("-Es", "-d64m");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-stack_size,0x10000000");
   end Linker;

end Pyro_Cli;
