#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
#
# Pyro's test runner: build, proofs, tag/doc agreement, golden files, differential tests against
# reference Lua 5.4.9 and mutation fuzzing (see docs/STYLE.md, "Testing").
#
#   tests/run            everything, 5 minute cap (every commit)
#   tests/run --full     clean proofs and long fuzzing, 30 minute cap (end of milestone)
#   tests/run --update   regenerate golden files, then run everything
#
# Only failures and a timing table are printed. The full log is tests/output/run.log.
#
# On a cap, an error, Ctrl-C or SIGTERM, every process the run started is killed, provers
# included (they leave their parent's process group); the unit stage checks this.

import argparse
import concurrent.futures
import os
import random
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TESTS = ROOT / "tests"
OUTPUT = TESTS / "output"
CORPUS = TESTS / "corpus"
# Proofs of concept of public PUC Lua CVEs (tests/cve/README.md), checked as corpus files.
CVE = TESTS / "cve"
GOLDEN = TESTS / "golden"
OFFICIAL = TESTS / "official" / "lua-5.4.9-tests"
KNOWN_DIFFERENCES = TESTS / "known-differences.md"
PYRO = ROOT / "cli" / "bin" / "pyrolua"
REFERENCE = Path(os.environ.get("PYRO_REF_LUA", "/opt/homebrew/opt/lua@5.4/bin"))
LUAC = REFERENCE / "luac"

# The pyrolua modes whose output has golden files.
GOLDEN_MODES = ("tokens", "ast", "check", "bytecode")

PROCESS_LIMIT = 10  # seconds for one pyrolua, lua or luac process
TOTAL_LIMIT = {"quick": 300, "full": 1800}

# Wall-clock cap of each stage, in seconds, within the total.
STAGE_LIMITS = {
    "quick": {"build": 120, "proof": 200, "tags": 10, "unit": 20, "golden": 30, "cli": 30,
              "differential": 60, "listing": 60, "fuzz": 30},
    "full": {"build": 120, "proof": 900, "tags": 10, "unit": 20, "golden": 30, "cli": 60,
             "differential": 60, "listing": 120, "fuzz": 600},
}
# The stages of the process check (tests/run --process-check).
for _limits in STAGE_LIMITS.values():
    _limits.update({"probe": 2, "probe-wait": 60})

# A command that leaves processes behind as provers do: a child in its own process group
# (as SPARK's wrapper starts cvc5 and z3) and one in the command's group, both long-lived.
# The marker (argv[1]) lets the check find them.
SPAWNER = """
import subprocess, sys, time
sleeper = [sys.executable, "-c", "import time; time.sleep(600)", sys.argv[1]]
subprocess.Popen(sleeper, start_new_session=True)
subprocess.Popen(sleeper)
time.sleep(600)
"""

# Constructs that nest as deep as the parser allows, and the deepest nesting PUC Lua's parser
# accepts for each (one level more is "C stack overflow"). The stack test parses and compiles
# both. At that depth, method calls need too many registers and for loops declare too many
# local variables, as in luac, so those report one error at the limit too.
AT_LIMIT_ERRORS = {"method": 1, "for": 1}
DEEP_CONSTRUCTS = {
    "parenthesis": (lambda n: "x = " + "(" * n + "1" + ")" * n, 196),
    "table": (lambda n: "x = " + "{" * n + "}" * n, 197),
    "function": (lambda n: "x = " + "function() return " * n + "1" + " end" * n, 98),
    "unary": (lambda n: "x = " + "- " * n + "1", 196),
    "concatenation": (lambda n: "x = " + "a .. " * n + "a", 196),
    "power": (lambda n: "x = " + "a ^ " * n + "a", 196),
    "call": (lambda n: "x = " + "f(" * n + ")" * n, 197),
    "method": (lambda n: "x = " + "a:m(" * n + ")" * n, 197),
    "index": (lambda n: "x = " + "a[" * n + "1" + "]" * n, 196),
    "and-or": (lambda n: "x = " + "(a and " * n + "b" + ")" * n, 98),
    "do": (lambda n: "do " * n + "end " * n, 198),
    "if": (lambda n: "if a then " * n + "end " * n, 197),
    "while": (lambda n: "while a do " * n + "end " * n, 197),
    "repeat": (lambda n: "repeat " * n + "until a " * n, 197),
    "for": (lambda n: "for i = 1, 2 do " * n + "end " * n, 197),
    "local-function": (lambda n: "local function f() " * n + "end " * n, 198),
    "assignment": (lambda n: "a" + ", a" * n + " = 1", 196),
}

# The front end's peak memory, in MB per MB of source, on the official test files (macOS
# arm64, measured 2026-11-01, with chunked growable arrays and 32-byte stored tree nodes).
# tests/run --full fails 25% above it.
MEMORY_PER_SOURCE_MB = 16.9

# Chunks that reach PUC Lua's compile-time limits, or come just short of them, generated
# rather than kept in the corpus because of their size. luac -p and pyrolua --check must agree on
# each, message included; luac -l -l and pyrolua --bytecode --lua-style on those accepted.
def _upvalues(count):
    locals_ = "".join(f"local u{i} = {i}\n" for i in range(150))
    inner = locals_.replace("local u", "local w")
    uses = "".join(f"x = u{i}\n" for i in range(150)) + "".join(f"x = w{i}\n"
                                                              for i in range(count - 150))
    return ("local function g()\n" + locals_ + "return function()\n" + inner
            + "return function()\n" + uses + "end end end\n")


LIMIT_CASES = {
    "locals-200": lambda: "local " + ", ".join(f"a{i}" for i in range(200)) + "\n",
    "locals-201": lambda: "local " + ", ".join(f"a{i}" for i in range(201)) + "\n",
    "locals-in-function": lambda: "\n\nlocal function f()\n"
                                  + "".join(f"local a{i}\n" for i in range(201)) + "end\n",
    "upvalues-255": lambda: _upvalues(255),
    "upvalues-256": lambda: _upvalues(256),
    "registers": lambda: "local x = f(" + ", ".join("1" for i in range(300)) + ")\n",
    "registers-concatenation": lambda: "local y = " + "..".join(f"a{i}" for i in range(260))
                                       + "\n",
    "constants": lambda: "local t = {}\n" + "".join(f"t[{i}.5] = 'v{i}'\n"
                                                    for i in range(70000)) + "return t\n",
    "table": lambda: "return {" + ", ".join(str(i) for i in range(70000)) + ", x = 1, f()}\n",
    "for-too-long": lambda: "for i = 1, 2 do\n" + "t = i\n" * 140000 + "end\n",
    "for-long": lambda: "for i = 1, 2 do\n" + "t = i\n" * 131000 + "end\n",
    "goto-long": lambda: "goto e\n" + "t = 1\n" * 140000 + "::e::\n",
    # A limit error and another error, in both orders: luac reports the first.
    "upvalues-then-syntax": lambda: _upvalues(256) + "x = = 1\n",
    "syntax-then-upvalues": lambda: "x = = 1\n" + _upvalues(256),
    "upvalues-then-scope": lambda: _upvalues(256) + "goto nowhere\n",
    "scope-then-upvalues": lambda: "local c <const> = 1\nc = 2\n" + _upvalues(256),
    "upvalues-cut-short": lambda: _upvalues(256).replace("end end end\n", "x = (\n"),
    # The limits of PUC's growing arrays (lmem.c), raised with no place.
    "gotos-32767": lambda: "do\n" + "goto l\n" * 32767 + "::l::\nend\n",
    "gotos-32768": lambda: "do\n" + "goto l\n" * 32768 + "::l::\nend\n",
    "breaks-32768": lambda: "while x do\n" + "if y then break end\n" * 32768 + "end\n",
    "labels-32768": lambda: "do\n" + "".join(f"::l{i}:: x = 1\n" for i in range(32768))
                            + "end\n",
    "debug-locals-32767": lambda: "do local a end\n" * 32767,
    "debug-locals-32768": lambda: "local function g()\n" + "do local a end\n" * 32768
                                  + "end\n",
    "functions-131071": lambda: "f = function() end\n" * 131071,
    "functions-131072": lambda: "f = function() end\n" * 131072,
    "functions-then-syntax": lambda: "f = function() end\n" * 131072 + "x = = 1\n",
    "syntax-then-gotos": lambda: "x = = 1\ndo\n" + "goto l\n" * 32768 + "::l::\nend\n",
}

# Mutants per run, and the fixed seed of the quick run.
FUZZ_MUTANTS = {"quick": 400, "full": 200000}
FUZZ_SEED = 1954


class StageTimeout(Exception):
    """A stage or one of its processes went over its time limit."""


# --------------------------------------------------------------------------------------------
# Process trees
#
# Each command runs in a process group of its own, but provers do not stay there: SPARK's
# wrapper starts cvc5 and z3 in groups of their own. So a command is stopped by freezing its
# whole tree (its group and every descendant, found through parent links while the parents
# are still alive), then killing every process in it.


def marker_processes(marker):
    """The processes whose command line contains marker."""
    listing = subprocess.run(["pgrep", "-f", marker], capture_output=True, text=True).stdout
    return [int(pid) for pid in listing.split()]


def process_table():
    """(pid, parent pid, process group) of every process."""
    listing = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,pgid="], capture_output=True,
                             text=True).stdout
    rows = []
    for line in listing.splitlines():
        fields = line.split()
        if len(fields) == 3 and all(field.isdigit() for field in fields):
            rows.append(tuple(int(field) for field in fields))
    return rows


def process_tree(root):
    """The processes of root's process group and all their descendants."""
    rows = process_table()
    children = {}
    for pid, parent, _ in rows:
        children.setdefault(parent, []).append(pid)
    tree = {pid for pid, _, group in rows if group == root}
    if any(pid == root for pid, _, _ in rows):
        tree.add(root)
    pending = list(tree)
    while pending:
        for child in children.get(pending.pop(), []):
            if child not in tree:
                tree.add(child)
                pending.append(child)
    tree.discard(os.getpid())
    return tree


def signal_process(pid, number):
    try:
        os.kill(pid, number)
    except (ProcessLookupError, PermissionError):
        pass


def kill_tree(root):
    """Kills root's process tree: frozen first, so that nothing escapes while it is found."""
    frozen = set()
    for _ in range(20):
        new = process_tree(root) - frozen
        if not new:
            break
        for pid in new:
            signal_process(pid, signal.SIGSTOP)
        frozen |= new
    for pid in frozen:
        signal_process(pid, signal.SIGKILL)


class Runner:
    def __init__(self, mode, update, log_name="run.log"):
        self.mode = mode
        self.update = update
        self.start = time.monotonic()
        self.failures = []
        self.timings = []
        self.stage = None
        self.stage_deadline = None
        OUTPUT.mkdir(parents=True, exist_ok=True)
        self.log_file = open(OUTPUT / log_name, "w", encoding="utf-8", errors="replace")
        # The process groups of the commands running now, and whether the run is stopping.
        self.active = set()
        self.active_lock = threading.Lock()
        self.stopping = False

    def launch(self, command, **options):
        """Starts command in a process group of its own, which kill_all can find."""
        if self.stopping:
            raise StageTimeout("the run is stopping")
        process = subprocess.Popen([str(part) for part in command], start_new_session=True,
                                   **options)
        with self.active_lock:
            self.active.add(process.pid)
        return process

    def finish(self, process):
        """Kills whatever is left of process's tree and forgets it."""
        kill_tree(process.pid)
        if process.poll() is None:
            process.wait()
        with self.active_lock:
            self.active.discard(process.pid)

    def kill_all(self):
        """Stops the run: kills the tree of every command still running."""
        self.stopping = True
        with self.active_lock:
            groups = list(self.active)
        for group in groups:
            kill_tree(group)

    # ----------------------------------------------------------------------------------------
    # Reporting

    def log(self, text):
        self.log_file.write(text if text.endswith("\n") else text + "\n")
        self.log_file.flush()

    def fail(self, text):
        self.failures.append(f"[{self.stage}] {text}")
        self.log(f"FAIL [{self.stage}] {text}")

    # ----------------------------------------------------------------------------------------
    # Processes

    def remaining(self):
        total_left = TOTAL_LIMIT[self.mode] - (time.monotonic() - self.start)
        stage_left = self.stage_deadline - time.monotonic()
        return min(total_left, stage_left)

    def run(self, command, limit=PROCESS_LIMIT, cwd=ROOT, what=None):
        """Runs command, killing its process tree when it exceeds limit or the stage's time.

        Returns (exit code, stdout bytes, stderr bytes). A timeout raises StageTimeout when the
        stage ran out of time, and is reported as a failure of what (a file) otherwise."""
        left = self.remaining()
        if left <= 0:
            raise StageTimeout(f"time limit reached before running {' '.join(map(str, command))}")
        stage_bound = left < limit
        limit = min(limit, left)
        process = self.launch(command, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        try:
            out, err = process.communicate(timeout=limit)
        except subprocess.TimeoutExpired:
            kill_tree(process.pid)
            process.communicate()
            description = " ".join(map(str, command))
            if stage_bound:
                raise StageTimeout(f"time limit reached while running {description}")
            self.fail(f"timeout after {limit:.0f} s: {description}" + (f" ({what})" if what else ""))
            return None, b"", b""
        finally:
            self.finish(process)
        return process.returncode, out, err

    # ----------------------------------------------------------------------------------------
    # Stages

    def stage_build(self):
        for directory in (ROOT, ROOT / "cli", ROOT / "tests" / "unit"):
            code, out, err = self.run(["alr", "-n", "build"], limit=self.remaining(), cwd=directory)
            self.log((out + err).decode(errors="replace"))
            if code != 0:
                self.fail(f"build failed in {directory.relative_to(ROOT) or '.'}:\n"
                          + tail((out + err).decode(errors="replace")))
                return False
        return True

    def stage_proof(self):
        # Always from scratch (-f): replaying earlier proof sessions can change what the
        # provers find within the steps limit, and a proof must fail the same way every time.
        # Quick runs reuse results from a cache keyed by the exact VC and prover settings, so
        # only VCs that changed are proved again; --full proves everything without it.
        # Results of earlier runs (possibly of units that no longer exist) must not count.
        for stale in (ROOT / "obj").glob("*/gnatprove"):
            shutil.rmtree(stale, ignore_errors=True)
        command = ["alr", "exec", "--", "gnatprove", "-P", "pyro_lua.gpr", "-f"]
        key = self.toolchain_key() if self.mode == "quick" else None
        if key is not None:
            cache = ROOT / "obj" / "proof-cache" / key
            cache.mkdir(parents=True, exist_ok=True)
            command.append(f"--memcached-server=file:{cache}")
        code, out, err = self.run(command, limit=self.remaining())
        text = (out + err).decode(errors="replace")
        self.log(text)
        if code != 0:
            self.fail("gnatprove reported unproved checks or errors:\n" + tail(text, 60))
            return
        summaries = sorted((ROOT / "obj").glob("*/gnatprove/gnatprove.out"),
                           key=lambda path: path.stat().st_mtime)
        summary = summaries[-1] if summaries else None
        if summary is not None:
            trusted = trusted_units()
            for line in summary.read_text(errors="replace").splitlines():
                match = re.match(r"\s+(Pyro[\w.]*) at (\S+) .*skipped; (body is )?SPARK_Mode => Off",
                                 line)
                if not match:
                    continue
                unit = match.group(1)
                if not any(unit == name or unit.startswith(name + ".") for name in trusted) \
                        and not is_generic_noise(unit, match.group(2)):
                    self.fail(f"not analysed by gnatprove (SPARK_Mode => Off) and not listed as "
                              f"trusted in docs/PROOFS.md: {unit} at {match.group(2)}")

    def toolchain_key(self):
        """gnatprove-<v>-why3-<v>-cvc5-<v>-z3-<v>, the proof cache's directory: the cache never
        outlives a toolchain change, so an upgrade cannot replay another version's results.
        None when a version cannot be read (the run then proves without the cache)."""
        code, out, err = self.run(["alr", "exec", "--", "gnatprove", "--version"], limit=60)
        text = (out + err).decode(errors="replace")
        def version(pattern):
            match = re.search(pattern, text)
            return match.group(1) if match else None
        parts = ["gnatprove", version(r"(?m)^FSF (\S+)"),
                 "why3", version(r"Why3 [^\n]*version (\S+)"),
                 "cvc5", version(r"cvc5 version (\S+)"),
                 "z3", version(r"Z3 version (\S+)")]
        return None if None in parts or code != 0 else "-".join(parts)

    def stage_tags(self):
        proofs = (ROOT / "docs" / "PROOFS.md").read_text()
        trusted = trusted_units()
        differences = KNOWN_DIFFERENCES.read_text() if KNOWN_DIFFERENCES.exists() else ""
        for path in sorted(list((ROOT / "src").rglob("*.ad[sb]")) + list((ROOT / "src").rglob("*.c"))):
            relative = path.relative_to(ROOT).as_posix()
            lines = path.read_text(errors="replace").splitlines()
            for number, line in enumerate(lines, 1):
                code = line.split("--", 1)[0] if path.suffix != ".c" else line
                # Hide_Info and Unhide_Info only keep definitions out of proofs: not trust.
                needs_trusted = (re.search(r"SPARK_Mode\s*(=>\s*|\(\s*)Off", code, re.I)
                                 or (re.search(r"pragma\s+Annotate", code, re.I)
                                     and not re.search(r"Hide_Info|Unhide_Info", line)))
                if needs_trusted:
                    window = "\n".join(lines[max(0, number - 4):number])
                    if "[trusted]" not in window:
                        self.fail(f"{relative}:{number}: SPARK_Mode => Off or pragma Annotate "
                                  "without a [trusted] tag")
                if "[trusted]" in line:
                    unit = unit_name(path)
                    if path.suffix == ".c":
                        unit = None
                    if unit is not None and not any(unit == name or unit.startswith(name + ".")
                                                    for name in trusted):
                        self.fail(f"{relative}:{number}: [trusted] spot in {unit}, which is not "
                                  "listed in docs/PROOFS.md#trusted-code")
                    if path.suffix == ".c" and relative not in proofs:
                        self.fail(f"{relative}:{number}: [trusted] C file not named in "
                                  "docs/PROOFS.md#trusted-code")
                if "[differs]" in line and relative not in differences:
                    self.fail(f"{relative}:{number}: [differs] spot not listed in "
                              "tests/known-differences.md")
                if re.search(r"--\s*TODO", line):
                    self.fail(f"{relative}:{number}: TODO comment (unfinished work goes in "
                              "docs/ROADMAP.md)")
        for path in sorted((ROOT / "src").rglob("*.ad[sb]")):
            head = path.read_text(errors="replace").splitlines()[:3]
            if not head or head[0] != "--  SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception":
                self.fail(f"{path.relative_to(ROOT)}: missing SPDX line")

    def stage_unit(self):
        unit = TESTS / "unit"
        if not (unit / "data" / "GraphemeBreakTest.txt").exists():
            self.fail("Unicode's GraphemeBreakTest.txt missing: run tools/generate-grapheme-tables")
            return
        code, out, err = self.run([unit / "bin" / "grapheme_test",
                                   unit / "data" / "GraphemeBreakTest.txt"])
        self.log((out + err).decode(errors="replace"))
        if code != 0:
            self.fail("grapheme conformance test failed:\n" + tail((out + err).decode(errors="replace")))
        code, out, err = self.run([unit / "bin" / "runtime_test"], limit=60)
        self.log((out + err).decode(errors="replace"))
        if code != 0:
            self.fail("runtime unit tests failed:\n" + tail((out + err).decode(errors="replace")))
        self.stack_test()
        self.process_check()

    def process_check(self):
        """tests/run leaves no process behind when a stage hits its cap, or when it is stopped
        with SIGTERM or SIGINT, even processes that left its process group (as provers do)."""
        for case, stop in (("probe", None), ("probe-wait", signal.SIGTERM),
                           ("probe-wait", signal.SIGINT)):
            marker = f"pyro-process-check-{os.getpid()}-{case}-{stop or 'cap'}"
            child = subprocess.Popen([sys.executable, str(Path(__file__).resolve()),
                                      "--process-check", case, marker],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if stop is not None:
                # The command and its two long-lived processes are running.
                for _ in range(100):
                    if len(set(marker_processes(marker)) - {child.pid}) >= 3:
                        break
                    time.sleep(0.1)
                child.send_signal(stop)
            try:
                child.wait(timeout=30)
            except subprocess.TimeoutExpired:
                child.kill()
                self.fail(f"process check: tests/run did not stop ({case}, {stop})")
            left = marker_processes(marker)
            if left:
                self.fail(f"process check: {len(left)} process(es) left behind "
                          f"({case}, {'cap' if stop is None else stop.name})")
                for pid in left:
                    signal_process(pid, signal.SIGKILL)

    def stage_probe(self, marker):
        """The stage of the process check: a command that starts long-lived processes."""
        self.run([sys.executable, "-c", SPAWNER, marker], limit=600)

    def stack_test(self):
        """Parses each construct at the nesting limit, and one level deeper, in a task whose
        stack is Pyro.Minimum_Stack_Size, and checks the stack it used left a margin."""
        minimum = minimum_stack_size()
        directory = OUTPUT / "stack"
        shutil.rmtree(directory, ignore_errors=True)
        directory.mkdir(parents=True)
        files, expected = [], []
        for name, (generate, depth) in DEEP_CONSTRUCTS.items():
            for extra in (0, 1):
                path = directory / f"{name}-{depth + extra}.lua"
                path.write_text(generate(depth + extra) + "\n")
                files.append(path)
                expected.append(1 if extra else AT_LIMIT_ERRORS.get(name, 0))
        code, out, err = self.run([TESTS / "unit" / "bin" / "stack_test"] + files)
        text = (out + err).decode(errors="replace")
        self.log(text)
        if code != 0:
            self.fail("stack test failed:\n" + tail(text))
            return
        counts = [int(count) for count in re.findall(r"^@.*: (\d+) errors$", text, re.M)]
        usages = [int(usage) for usage in re.findall(r"^ *\d+ \|.*\| *\d+ \| *(\d+)", text, re.M)]
        if len(counts) != len(files) or len(usages) != len(files):
            self.fail("stack test: unexpected output:\n" + tail(text))
            return
        for path, count, errors in zip(files, counts, expected):
            if count != errors:
                self.fail(f"stack test: {path.name}: {count} errors, expected {errors}")
        # A quarter of the stack Pyro promises, so other compilers and targets keep a margin.
        if max(usages) > minimum // 4:
            self.fail(f"stack test: the front end used {max(usages)} bytes of stack, more than a "
                      f"quarter of Pyro.Minimum_Stack_Size ({minimum}); raise it, with the new "
                      "measurement in docs/PROOFS.md")
        self.log(f"most stack used: {max(usages)} bytes")

    def stage_cli(self):
        """The pyrolua program on files it cannot read and on large files."""
        directory = OUTPUT / "cli"
        shutil.rmtree(directory, ignore_errors=True)
        directory.mkdir(parents=True)
        unreadable = directory / "unreadable.lua"
        unreadable.write_text("x = 1\n")
        unreadable.chmod(0)
        cases = [(directory / "missing.lua", "cannot open", ": No such file or directory"),
                 (directory, "cannot read", ": Is a directory")]
        if os.geteuid() != 0:  # root reads it anyway
            cases.append((unreadable, "cannot open", ": Permission denied"))
        for path, what, why in cases:
            for style in ([], ["--lua-style"]):
                code, out, err = self.run([PYRO, "--check"] + style + [path])
                expected = f"pyrolua: {what} {path}{why}\n".encode()
                if code != 1 or out or err != expected:
                    self.fail(f"pyrolua --check {' '.join(style)} {path}: exit {code}, "
                              f"{(out + err)!r}, expected exit 1, {expected!r}")
        unreadable.chmod(0o644)
        # About 10 MB of real code: every corpus and official file, each in a block of its own.
        official = sorted(OFFICIAL.rglob("*.lua")) if OFFICIAL.exists() else []
        large = directory / "large.lua"
        written, blocks = self.write_real_code(corpus_files() + official, large, 10 * 2 ** 20)
        self.log(f"large file: {written} bytes, {blocks} blocks")
        self.expect_check(large, 0, b"")
        if self.mode == "full" and official:
            # Peak memory of the front end per MB of source, on the official files.
            measured = directory / "official.lua"
            size, _ = self.write_real_code(official, measured, 10 * 2 ** 20)
            peak = self.peak_memory([PYRO, "--check", measured])
            if peak is not None:
                ratio = peak / (size / 2 ** 20) / 2 ** 20
                self.log(f"front-end memory: {ratio:.1f} MB per source MB")
                if ratio > MEMORY_PER_SOURCE_MB * 1.25:
                    self.fail(f"the front end needs {ratio:.1f} MB of memory per MB of source, more "
                              f"than 25% above the baseline of {MEMORY_PER_SOURCE_MB}")
            measured.unlink()
        if self.mode == "full":
            # The largest chunk Pyro accepts, and one byte more.
            limit = 2 ** 28
            for size, code, output in ((limit, 0, b""), (limit + 1, 1, b"pyrolua: not enough memory\n")):
                path = directory / f"size-{size}.lua"
                head, end = b"x = 1 --[[", b"]]\nreturn x\n"
                with open(path, "wb") as file:
                    file.write(head)
                    file.write(b"a" * (size - len(head) - len(end)))
                    file.write(end)
                self.expect_check(path, code, output, ["--lua-style"])
                path.unlink()
        large.unlink()

    def write_real_code(self, sources, path, size):
        """Writes size bytes or more of Lua code to path: the sources luac accepts, each in a
        block of its own, repeated. Returns (bytes written, number of blocks)."""
        blocks = []
        block_file = path.with_suffix(".block.lua")
        for source in sources:
            text = source.read_bytes()
            if text.startswith(b"#"):
                text = b"--" + text
            block = b"do local function f(...)\n" + text + b"\nend end\n"
            block_file.write_bytes(block)
            code, _, _ = self.run([LUAC, "-p", block_file])
            if code == 0:
                blocks.append(block)
        block_file.unlink(missing_ok=True)
        written = 0
        with open(path, "wb") as file:
            while blocks and written < size:
                for block in blocks:
                    file.write(block)
                    written += len(block)
        return written, len(blocks)

    def peak_memory(self, command):
        """The peak resident memory of command, in bytes, or None if it failed."""
        process = self.launch(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            _, status, usage = os.wait4(process.pid, 0)
            process.returncode = os.waitstatus_to_exitcode(status)
        finally:
            self.finish(process)
        if process.returncode != 0:
            self.fail(f"{' '.join(map(str, command))} exited with {process.returncode}")
            return None
        # ru_maxrss is in bytes on macOS and in kilobytes on Linux.
        return usage.ru_maxrss if sys.platform == "darwin" else usage.ru_maxrss * 1024

    def expect_check(self, path, expected_code, expected_output, style=()):
        code, out, err = self.run([PYRO, "--check", *style, path], limit=60)
        if code is not None and (code != expected_code or out + err != expected_output):
            self.fail(f"pyrolua --check {path.relative_to(ROOT)}: exit {code}, "
                      f"{tail((out + err).decode(errors='replace'))!r}")

    def stage_golden(self):
        if self.update:
            shutil.rmtree(GOLDEN, ignore_errors=True)
        expected_files = set()
        for source in corpus_files():
            relative = (source.relative_to(CORPUS) if source.is_relative_to(CORPUS)
                        else Path("cve") / source.relative_to(CVE))
            for mode in GOLDEN_MODES:
                golden = GOLDEN / relative.with_suffix("." + mode)
                expected_files.add(golden)
                code, out, err = self.run([PYRO, "--" + mode, source.relative_to(ROOT)],
                                          what=str(relative))
                if code is None:
                    continue
                actual = out + err + f"exit {code}\n".encode()
                if self.update:
                    golden.parent.mkdir(parents=True, exist_ok=True)
                    golden.write_bytes(actual)
                elif not golden.exists():
                    self.fail(f"no golden file {golden.relative_to(ROOT)} "
                              "(run tests/run --update and review the diff)")
                elif golden.read_bytes() != actual:
                    self.fail(f"--{mode} output of {source.relative_to(ROOT)} differs from "
                              f"{golden.relative_to(ROOT)}")
                    self.log(actual.decode(errors="replace"))
        if GOLDEN.exists():
            for golden in GOLDEN.rglob("*"):
                if golden.is_file() and golden not in expected_files:
                    self.fail(f"stale golden file {golden.relative_to(ROOT)}")

    def stage_differential(self):
        if not OFFICIAL.exists():
            self.fail("official test suite missing: run tools/fetch-lua-tests")
        files = corpus_files() + (sorted(OFFICIAL.rglob("*.lua")) if OFFICIAL.exists() else [])
        exempt = message_exemptions()

        def compare(source):
            relative = source.relative_to(ROOT)
            reference = self.check_reference(relative)
            pyro = self.check_pyro(relative)
            return relative, reference, pyro

        with concurrent.futures.ThreadPoolExecutor(os.cpu_count() or 4) as pool:
            for relative, reference, pyro in pool.map(compare, files):
                if reference is None or pyro is None:
                    continue
                if reference[0] != pyro[0]:
                    self.fail(f"{relative}: luac -p {verdict(reference)}, pyrolua --check "
                              f"{verdict(pyro)}")
                elif reference[1] != pyro[1]:
                    self.fail(f"{relative}: error line differs: luac -p {verdict(reference)}, "
                              f"pyrolua --check {verdict(pyro)}")
                elif reference[2] != pyro[2] and relative.as_posix() not in exempt:
                    self.fail(f"{relative}: message differs (not in tests/known-differences.md): "
                              f"luac -p {verdict(reference)}, pyrolua --check {verdict(pyro)}")

    def stage_listing(self):
        """pyrolua --bytecode --lua-style against luac -l -l on every chunk luac accepts."""
        if not OFFICIAL.exists():
            self.fail("official test suite missing: run tools/fetch-lua-tests")
        directory = OUTPUT / "limits"
        shutil.rmtree(directory, ignore_errors=True)
        directory.mkdir(parents=True)
        generated = []
        for name, generate in LIMIT_CASES.items():
            path = directory / f"{name}.lua"
            path.write_text(generate())
            generated.append(path)
        files = corpus_files() + (sorted(OFFICIAL.rglob("*.lua")) if OFFICIAL.exists() else [])

        def compare(source):
            relative = source.relative_to(ROOT)
            reference = self.check_reference(relative)
            if source in generated:
                pyro = self.check_pyro(relative)
                if reference is not None and pyro is not None and reference != pyro:
                    return relative, (f"luac -p {verdict(reference)}, pyrolua --check "
                                      f"{verdict(pyro)}")
            if reference is None or not reference[0]:
                return relative, None
            return relative, self.compare_listing(relative)

        compared = 0
        with concurrent.futures.ThreadPoolExecutor(os.cpu_count() or 4) as pool:
            for relative, difference in pool.map(compare, files + generated):
                compared += 1
                if difference is not None:
                    self.fail(f"{relative}: {difference}")
        self.log(f"listing: {compared} chunks compared")

    def stage_fuzz(self):
        seeds = [path.read_bytes() for path in corpus_files()]
        if OFFICIAL.exists():
            seeds += [path.read_bytes() for path in sorted(OFFICIAL.rglob("*.lua"))]
        if not seeds:
            return
        scratch = OUTPUT / "fuzz"
        shutil.rmtree(scratch, ignore_errors=True)
        scratch.mkdir(parents=True)
        failures = OUTPUT / "fuzz-failures"
        seed = FUZZ_SEED if self.mode == "quick" else int(time.time())
        self.log(f"fuzz seed {seed}")
        generator = random.Random(seed)
        count = FUZZ_MUTANTS[self.mode]
        mutants = [(index, mutate(generator, generator.choice(seeds)))
                   for index in range(count)]

        def check(item):
            index, text = item
            path = scratch / f"mutant{index}.lua"
            path.write_bytes(text)
            relative = path.relative_to(ROOT)
            reference = self.check_reference(relative)
            pyro = self.check_pyro(relative)
            listing = None
            if reference is not None and pyro is not None and reference[0] and pyro[0]:
                listing = self.compare_listing(relative)
            return index, path, text, reference, pyro, listing

        disagreements = 0
        done = 0
        try:
            with concurrent.futures.ThreadPoolExecutor(os.cpu_count() or 4) as pool:
                for index, path, text, reference, pyro, listing in pool.map(check, mutants):
                    done += 1
                    if reference is None or pyro is None:
                        continue
                    # Both reject: the same line and message (luac -p's first error), except
                    # for precompiled chunks (tests/known-differences.md).
                    if (reference[0] != pyro[0] or listing is not None
                            or (not reference[0] and reference != pyro
                                and not is_binary_chunk(pyro))):
                        disagreements += 1
                        failures.mkdir(parents=True, exist_ok=True)
                        kept = failures / f"seed{seed}-mutant{index}.lua"
                        kept.write_bytes(text)
                        if disagreements <= 10:
                            self.fail(f"{kept.relative_to(ROOT)}: luac -p {verdict(reference)}, "
                                      f"pyrolua --check {verdict(pyro)}"
                                      + (f"; {listing}" if listing else ""))
                    path.unlink(missing_ok=True)
        except StageTimeout:
            if self.mode == "quick":
                raise
            self.log(f"fuzz stopped by its time limit after {done} mutants")
        if disagreements > 10:
            self.fail(f"{disagreements} disagreements in all (first 10 shown; all "
                      "kept in tests/output/fuzz-failures)")
        self.log(f"fuzz: {done} mutants, {disagreements} disagreements (acceptance, messages "
                 "or listings)")

    # ----------------------------------------------------------------------------------------
    # Checking one file

    def check_reference(self, relative):
        code, out, err = self.run([LUAC, "-p", relative], what=str(relative))
        if code is None:
            return None
        return parse_check(code, err, LUAC.name, relative)

    def compare_listing(self, relative):
        """None when pyrolua --bytecode --lua-style prints what luac -l -l prints for relative
        (addresses masked), else where they first differ."""
        code, reference, err = self.run([LUAC, "-l", "-l", "-o", "/dev/null", relative],
                                        what=str(relative))
        if code is None:
            return None
        code, listing, err = self.run([PYRO, "--bytecode", "--lua-style", relative],
                                      what=str(relative))
        if code is None:
            return None
        if code != 0:
            return f"pyrolua --bytecode exited with {code}: {(listing + err)[:300]!r}"
        expected = mask_addresses(reference).splitlines()
        actual = mask_addresses(listing).splitlines()
        if expected == actual:
            return None
        for number, (left, right) in enumerate(zip(expected, actual), 1):
            if left != right:
                return f"listing line {number}: luac {left!r}, pyrolua {right!r}"
        return f"listing lengths differ: luac {len(expected)} lines, pyrolua {len(actual)}"

    def check_pyro(self, relative):
        code, out, err = self.run([PYRO, "--check", "--lua-style", relative], what=str(relative))
        if code is None:
            return None
        if code not in (0, 1) or out:
            self.fail(f"{relative}: pyrolua --check exited with {code}: {(out + err)[:300]!r}")
            return None
        return parse_check(code, err, "pyrolua", relative)

    # ----------------------------------------------------------------------------------------

    def execute(self, stages):
        try:
            return self.execute_stages(stages)
        except KeyboardInterrupt:
            self.kill_all()
            print("tests/run interrupted: every process it started has been killed")
            return 130
        except BaseException:
            self.kill_all()
            raise

    def execute_stages(self, stages):
        for name, function in stages:
            self.stage = name
            limit = STAGE_LIMITS[self.mode][name]
            self.stage_deadline = time.monotonic() + limit
            started = time.monotonic()
            stamp = time.strftime("%H:%M:%S")
            failures_before = len(self.failures)
            proceed = True
            try:
                result = function()
                proceed = result is not False
            except StageTimeout as timeout:
                self.fail(f"stage over its {limit} s limit: {timeout}")
                proceed = False
            elapsed = time.monotonic() - started
            status = "ok" if len(self.failures) == failures_before else "FAIL"
            self.timings.append((stamp, name, elapsed, limit, status))
            if not proceed or time.monotonic() - self.start > TOTAL_LIMIT[self.mode]:
                break
        for failure in self.failures:
            print(failure)
        if self.failures:
            print()
        print(f"{'started':<10}{'stage':<14}{'seconds':>9}{'limit':>8}  result")
        for stamp, name, elapsed, limit, status in self.timings:
            print(f"{stamp:<10}{name:<14}{elapsed:>9.1f}{limit:>8}  {status}")
        total = time.monotonic() - self.start
        print(f"{'':<10}{'total':<14}{total:>9.1f}{TOTAL_LIMIT[self.mode]:>8}  "
              f"{'FAIL' if self.failures else 'ok'}")
        if self.failures:
            print(f"\n{len(self.failures)} failure(s); full log in {(OUTPUT / 'run.log').relative_to(ROOT)}")
        return 1 if self.failures else 0


# --------------------------------------------------------------------------------------------
# Helpers


def tail(text, lines=30):
    return "\n".join(text.rstrip().splitlines()[-lines:])


def corpus_files():
    """Pyro's corpus and the CVE proofs of concept (their goldens are in golden/cve/)."""
    return sorted(CORPUS.rglob("*.lua")) + sorted(CVE.rglob("*.lua"))


def minimum_stack_size():
    """Pyro.Minimum_Stack_Size, in bytes, from src/common/pyro.ads."""
    text = (ROOT / "src" / "common" / "pyro.ads").read_text()
    match = re.search(r"Minimum_Stack_Size : constant := (\d+) \* 2 \*\* (\d+);", text)
    return int(match.group(1)) * 2 ** int(match.group(2))


def unit_name(path):
    """Ada unit name of a GNAT-named source file: pyro-floats.adb is Pyro.Floats."""
    return ".".join("_".join(word.capitalize() for word in part.split("_"))
                    for part in path.stem.split("-"))


def trusted_units():
    """Unit names in the trusted-code table of docs/PROOFS.md."""
    text = (ROOT / "docs" / "PROOFS.md").read_text()
    section = text.split("## Trusted code", 1)[-1].split("\n## ", 1)[0]
    return re.findall(r"^\|\s*`(Pyro[\w.]*)`", section, re.M)


# Library-level instances of SPARKlib's functional containers (ghost models), which
# SPARKlib proves itself.
FUNCTIONAL_INSTANCES = {"Pyro.Kind_Sequences", "Pyro.Value_Maps", "Pyro.Value_Sequences"}


def is_generic_noise(unit, location):
    """Entities gnatprove reports as skipped that come from generics proven elsewhere: the
    deallocation instances and the SPARKlib model inside every growable-array instance, and
    the SPARKlib functional containers instantiated as units of their own."""
    return (re.search(r"\.(Free\w*)\w*\.\1$|\.Models(\.|$)", unit) is not None
            or any(unit == name or unit.startswith(name + ".") for name in FUNCTIONAL_INSTANCES)
            or location.startswith("spark-containers-functional-"))


def message_exemptions():
    """Files whose error message may differ from luac's: backquoted paths in the
    known-differences list."""
    if not KNOWN_DIFFERENCES.exists():
        return set()
    return set(re.findall(r"`(tests/[^`]+\.lua)`", KNOWN_DIFFERENCES.read_text()))


def parse_check(code, err, program, relative):
    """(accepted, line, message) from the output of luac -p or pyrolua --check."""
    if code == 0:
        return (True, None, None)
    text = err.decode("latin-1").rstrip("\n")
    for prefix in (str(program) + ": ", str(LUAC) + ": "):
        if text.startswith(prefix):
            text = text[len(prefix):]
            break
    name = relative.as_posix()
    if len(name) + 1 > 60:
        name = "..." + name[-56:]
    match = re.match(re.escape(name) + r":(\d+): (.*)", text, re.S)
    if match:
        return (False, int(match.group(1)), match.group(2))
    return (False, None, text)


def is_binary_chunk(result):
    """The (accepted, line, message) of pyrolua --check refuses a precompiled chunk."""
    return not result[0] and result[2] is not None and "precompiled chunks" in result[2]


def mask_addresses(text):
    """A listing with the addresses luac prints replaced (tests/known-differences.md)."""
    return re.sub(rb"0x[0-9a-fA-F]+", b"ADDRESS", text)


def verdict(result):
    if result[0]:
        return "accepts"
    where = f"line {result[1]}" if result[1] is not None else "no line"
    return f"rejects ({where}: {result[2]!r})"


TOKENS = [b"end", b"(", b")", b"=", b",", b"local", b"function", b"..", b"...", b"[[", b"]]",
          b"--", b"\"", b"'", b"\\", b"::", b"goto", b"break", b"<const>", b"<close>", b"0x",
          b"1e", b".", b"{", b"}", b"[", b"]", b"\n", b"return", b"if", b"then", b"do", b"<", b">",
          b"\\u{", b"\\x", b"\\z", b"[=[", b"]=]", b";", b":", b"#", b"~", b"//", b"\r"]


def mutate(generator, text):
    """A random mutation of a Lua source: byte edits, token insertions, deletions and copies."""
    data = bytearray(text)
    for _ in range(generator.choice((1, 1, 1, 2, 3))):
        position = generator.randrange(len(data) + 1)
        choice = generator.randrange(7)
        if choice == 0 and data:
            del data[position:position + generator.randint(1, 16)]
        elif choice == 1:
            data[position:position] = generator.choice(TOKENS)
        elif choice == 2 and data:
            start = generator.randrange(len(data))
            data[position:position] = data[start:start + generator.randint(1, 40)]
        elif choice == 3 and position < len(data):
            data[position] = generator.randrange(256)
        elif choice == 4 and position < len(data):
            data[position] = generator.choice(b"(){}[]=.,;:'\"\\-+*/%^#&|~<>0123456789xeEpP \n")
        elif choice == 5:
            data = data[:position]
        else:
            data[position:position] = bytes([generator.randrange(32, 127)])
    return bytes(data)


def install_signal_handlers(runner):
    """SIGINT and SIGTERM kill every process the run started, then end the run."""
    def stop(number, frame):
        runner.kill_all()
        raise KeyboardInterrupt
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)


def main():
    parser = argparse.ArgumentParser(description="Pyro test runner")
    parser.add_argument("--full", action="store_true",
                        help="clean proofs and long fuzzing (30 minute cap)")
    parser.add_argument("--update", action="store_true",
                        help="regenerate golden files before running")
    parser.add_argument("--only", metavar="STAGES",
                        help="run only these comma-separated stages (a partial check, not a "
                             "green run)")
    parser.add_argument("--skip-proof", action="store_true",
                        help="every stage but proof (Linux CI: proofs run locally before each "
                             "push)")
    parser.add_argument("--process-check", nargs=2, metavar=("STAGE", "MARKER"),
                        help=argparse.SUPPRESS)
    arguments = parser.parse_args()
    if arguments.process_check:
        stage, marker = arguments.process_check
        runner = Runner("quick", False, log_name=f"{marker}.log")
        install_signal_handlers(runner)
        runner.execute([(stage, lambda: runner.stage_probe(marker))])
        (OUTPUT / f"{marker}.log").unlink(missing_ok=True)
        sys.exit(0)
    runner = Runner("full" if arguments.full else "quick", arguments.update)
    install_signal_handlers(runner)
    stages = [
        ("build", runner.stage_build),
        ("proof", runner.stage_proof),
        ("tags", runner.stage_tags),
        ("unit", runner.stage_unit),
        ("golden", runner.stage_golden),
        ("cli", runner.stage_cli),
        ("differential", runner.stage_differential),
        ("listing", runner.stage_listing),
        ("fuzz", runner.stage_fuzz),
    ]
    if arguments.skip_proof:
        stages = [(name, function) for name, function in stages if name != "proof"]
    if arguments.only:
        wanted = arguments.only.split(",")
        unknown = [name for name in wanted if name not in dict(stages)]
        if unknown:
            parser.error(f"unknown stage(s): {', '.join(unknown)}")
        stages = [(name, function) for name, function in stages if name in wanted]
    sys.exit(runner.execute(stages))


if __name__ == "__main__":
    main()
