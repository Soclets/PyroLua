--
--  Unit tests for what the pyrolua program cannot reach.

with "config/pyro_lua_unit_config.gpr";
with "pyro_lua.gpr";

project Pyro_Lua_Unit is

   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Pyro_Lua_Unit_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("grapheme_test.adb", "stack_test.adb", "runtime_test.adb");

   package Compiler is
      for Local_Configuration_Pragmas use "../../pyro.adc";
      for Default_Switches ("Ada") use
        ("-gnat2022", "-g", "-O1", "-gnatwa", "-gnatwe", "-gnatVa", "-gnatf",
         "-gnaty3", "-gnatyaAbBcdefhiIklnOprStux", "-gnatyM100");
   end Compiler;

   package Binder is
      --  Report each task's stack use, measured by filling its stack with a pattern.
      for Switches ("stack_test.adb") use ("-u100");
   end Binder;

end Pyro_Lua_Unit;
